# Fee-Ver 2.0 — Environment Variables

# Paths
MODEL_PATH=models/merged/qwen3vl_merged
HOSPITAL_DB_PATH=models/reserved/hospital_db.sqlite
PHILHEALTH_ANNEX_A_PATH=models/reserved/philhealth_annex_a.json
PHILHEALTH_ANNEX_B_PATH=models/reserved/philhealth_annex_b.json

# Encryption (AES-256-GCM, base64-encoded 32-byte key)
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_SECRET_KEY=

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Inference
MAX_NEW_TOKENS=512

# Rule engine
HOSPITAL_FUZZY_THRESHOLD=80
PHILHEALTH_FUZZY_THRESHOLD=82
PRICE_DELTA_TOLERANCE=0.05

# HuggingFace (for base model download)
HF_TOKEN=
